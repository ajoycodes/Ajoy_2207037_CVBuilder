<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.demo.WelcomeController"
           style="-fx-background-color: linear-gradient(to bottom, #4A6CF7, #6E8CFF);">

    <VBox spacing="18" alignment="CENTER">

        <Label text="Create Your Own CV"
               style="-fx-text-fill: white; -fx-font-size: 42px; -fx-font-weight: bold;"/>

        <Label text=" by Ajoy Saha (2207037)"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-opacity: 0.9;"/>

        <Button text="Get Started"
                onAction="#startApp"
                style="-fx-background-color: white;
                       -fx-text-fill: #4A6CF7;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-padding: 14 40;
                       -fx-background-radius: 12;" />

    </VBox>

</StackPane>