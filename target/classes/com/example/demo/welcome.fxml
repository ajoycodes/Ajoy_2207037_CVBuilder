<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.demo.WelcomeController"
           style="-fx-background-color: linear-gradient(to bottom, #4A6CF7, #6E8CFF);">

    <VBox spacing="25" alignment="CENTER" maxWidth="650">

        <padding>
            <Insets top="60" right="40" bottom="60" left="40"/>
        </padding>

        <Label text="Create Your Own CV"
               style="-fx-text-fill: white;
                      -fx-font-size: 42px;
                      -fx-font-weight: bold;
                      -fx-wrap-text: true;
                      -fx-text-alignment: center;"/>

        <Label text="JavaFX Assignment by Roll 2207037"
               style="-fx-text-fill: white;
                      -fx-font-size: 18px;
                      -fx-opacity: 0.95;
                      -fx-wrap-text: true;
                      -fx-text-alignment: center;" />

        <Button text="Get Started"
                onAction="#startApp"
                style="-fx-background-color: white;
                       -fx-text-fill: #4A6CF7;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-padding: 14 40;
                       -fx-background-radius: 12;"/>

    </VBox>

</StackPane>