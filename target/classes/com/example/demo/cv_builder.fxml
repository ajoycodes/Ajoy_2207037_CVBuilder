<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.SplitPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.CvBuilderController"
            stylesheets="@styles.css">

    <center>
        <SplitPane dividerPositions="0.22">
            <items>

                <!-- LEFT PANEL: Saved CVs -->
                <VBox spacing="12" style="-fx-padding: 16;">
                    <Label text="Saved CVs" styleClass="section-title"/>

                    <TextField fx:id="search" promptText="Search by name or email"/>

                    <ListView fx:id="savedList" prefHeight="500"/>

                    <HBox spacing="10">
                        <Button text="New" onAction="#newCv"/>
                        <Button text="Save DB" onAction="#saveDb"/>
                    </HBox>

                    <HBox spacing="10">
                        <Button text="Update" onAction="#updateDb"/>
                        <Button text="Delete" onAction="#deleteDb"/>
                    </HBox>

                </VBox>

                <!-- RIGHT: Form + Preview -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <content>
                        <VBox spacing="30" style="-fx-padding: 20;">

                            <!-- FORM SECTION -->
                            <VBox spacing="18" styleClass="panel-card">

                                <Label text="CV Details" styleClass="section-title"/>

                                <Label text="Full Name"/>
                                <TextField fx:id="fn"/>

                                <Label text="Email"/>
                                <TextField fx:id="em"/>

                                <Label text="Phone"/>
                                <TextField fx:id="ph"/>

                                <Label text="Address"/>
                                <TextField fx:id="ad"/>

                                <Label text="Profile Summary"/>
                                <TextArea fx:id="sm" prefRowCount="3"/>

                                <Label text="Education"/>
                                <TextArea fx:id="ed" prefRowCount="3"/>

                                <Label text="Experience"/>
                                <TextArea fx:id="ex" prefRowCount="3"/>

                                <Label text="Skills"/>
                                <HBox spacing="10">
                                    <TextField fx:id="ns"/>
                                    <Button text="Add" onAction="#add"/>
                                </HBox>

                                <ListView fx:id="lv" prefHeight="120"/>

                                <Button text="Remove Skill" onAction="#rm"/>
                                <Button text="Generate Preview" onAction="#gen"/>
                                <Button text="Save as HTML" onAction="#save"/>

                            </VBox>

                            <!-- PREVIEW SECTION -->
                            <VBox spacing="16" styleClass="panel-card">
                                <Label text="Preview" styleClass="section-title"/>
                                <WebView fx:id="pv" prefHeight="900"/>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>

            </items>
        </SplitPane>
    </center>

    <!-- BOTTOM STATUS BAR -->
    <bottom>
        <HBox>
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="st" text="Ready."/>
        </HBox>
    </bottom>

</BorderPane>